    "express": "^4.19.2",
    "highlight.js": "^11.9.0",
    "mime-types": "^2.1.35",
    "multer": "^2.2.0",
    "pdfjs-dist": "^4.6.82",
    "web-push": "^3.6.7",
    "ws": "^8.17.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "yauzl": "^3.1.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
