  "description": "Personal remote control panel for a Windows PC: Claude Code session manager, file manager, shell console, system dashboard. Mobile-first, accessed over Tailscale.",
  "private": true,
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "build:vendor": "node build.js",
